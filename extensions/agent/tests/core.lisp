    (let ((slow-gate (make-gate)) (entered nil) (seen nil))
      (agent:register-provider
       manager "slow"
       (lambda (request emit context)
         (declare (ignore request))
         (agent:register-cancellation context (lambda () (open-gate slow-gate)))
         (setf entered t) (wait-gate slow-gate)
         (funcall emit "hel") (funcall emit "lo λ") (agent:json-object)))
      (agent:register-provider manager "fake"
                               (lambda (request emit context)
                                 (declare (ignore request context))
                                 (warn "Nonfatal provider warning")
                                 (funcall emit "fast") (agent:json-object)))
      (let ((slow (new-session manager directory :provider "slow"))
            (fast (new-session manager directory)))
        (unwind-protect
             (progn
               (let ((view (agent:subscribe-session slow (lambda (event) (push event seen)))))
                 (await (agent:submit-message slow "wait"))
                 (wait-for (lambda () entered))
                 (agent:unsubscribe-session slow view))
               (agent:subscribe-session fast (lambda (event) (declare (ignore event))
                                              (warn "Nonfatal view warning") (error "broken view")))
               (await (agent:submit-message fast "go")) (idle fast)
               (ok (equal "running" (state slow)) "a blocked provider does not stall another session")
               (let* ((snapshot (agent:session-snapshot fast))
                      (message (aref (field (aref (field snapshot "turns") 0) "messages") 0)))
                 (setf (gethash "content" message) "tampered"))
               (ok (equal "go" (field (aref (field (aref (field (agent:session-snapshot fast) "turns") 0)
                                                       "messages") 0) "content"))
                   "snapshots do not share nested mutable objects")
               (open-gate slow-gate) (idle slow)
               (ok (equal "hello λ" (field (aref (field (aref (field (agent:session-snapshot slow) "turns") 0)
                                                            "messages") 1) "content"))
                   "fragmented streaming completes after the view has closed")
               (ok (plusp (length (field (agent:session-snapshot fast) "diagnostics")))
                   "subscriber exceptions are isolated and recorded")
               (ok (null (find-package :lem-core)) "the core has no editor or extension dependency"))
          (open-gate slow-gate))))))

(deftest submission-real-process-crash-boundaries
  (dolist (phase '("submission-before" "submission-after"))
    (let* ((directory (merge-pathnames (format nil "lem-submission-crash-~a/" (store:new-id)) (uiop:temporary-directory)))
           (ready (merge-pathnames "ready.txt" directory)) (log (merge-pathnames "worker.log" directory))
           (process nil))
      (unwind-protect
           (progn
             (store:ensure-private-directory directory)
             (setf process
                   (sb-ext:run-program
                    (namestring sb-ext:*runtime-pathname*)
                    (list "--noinform" "--no-sysinit" "--no-userinit" "--script"
                          (namestring (asdf:system-relative-pathname "lem-agent" "tests/crash-worker.lisp"))
                          (namestring (asdf:system-source-directory "lem")) (namestring directory) phase)
                    :search nil :wait nil :input nil :output log :error :output))
             (loop repeat 1500 until (probe-file ready)
                   do (unless (sb-ext:process-alive-p process)
                        (error "Submission crash worker exited early: ~a" (uiop:read-file-string log)))
                      (sleep 0.01)
                   finally (unless (probe-file ready) (error "Submission crash worker did not reach boundary")))
             (ok (signals (agent:make-manager :directory directory)) "a live original host excludes recovery")
             (sb-ext:process-kill process sb-posix:sigkill) (sb-ext:process-wait process)
             (let ((manager (agent:make-manager :directory directory)) (requests 0))
               (unwind-protect
                    (progn
                      (agent:register-provider manager "fake" (lambda (&rest ignored) (declare (ignore ignored)) (incf requests)))
                      (multiple-value-bind (sessions errors) (agent:restore-sessions manager)
                        (ok (null errors))
                        (let ((session (first sessions)))
                          (await (agent:session-ready session))
                          (ok (eq (not (null (agent:find-submission session "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))
                                  (equal phase "submission-after"))
                              "the same session checkpoint distinguishes durable acceptance before UI cleanup")
                          (ok (= (if (equal phase "submission-after") 1 0)
                                 (length (field (agent:session-snapshot session) "queue"))))
                          (ok (zerop requests) "restoration never replays the accepted or unaccepted submission"))))
                 (agent:close-manager manager :wait t))))
        (when process
          (when (sb-ext:process-alive-p process) (sb-ext:process-kill process sb-posix:sigkill))
          (sb-ext:process-wait process) (sb-ext:process-close process))
        (when (uiop:directory-exists-p directory) (uiop:delete-directory-tree directory :validate t))))))


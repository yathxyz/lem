(defpackage :lem-agent/tests
  (:use :cl :rove)
  (:local-nicknames (:agent :lem-agent) (:store :lem-daemon/recovery-store)))
(in-package :lem-agent/tests)

(defun field (object key) (gethash key object))
(defun array-items (value) (coerce value 'list))

(defun await (receipt)
  (multiple-value-bind (value done) (agent:await-request receipt :timeout 8)
    (unless done (error "Agent receipt timed out")) value))

(defun wait-for (predicate)
  (loop repeat 400 when (funcall predicate) return t do (sleep 0.01)
        finally (error "Agent state did not reach the expected condition")))

(defun state (session) (field (agent:session-snapshot session) "status"))
(defun idle (session &optional (turn-count 1))
  (wait-for (lambda ()
              (let ((snapshot (agent:session-snapshot session)))
                (and (equal (field snapshot "status") "idle")
                     (null (field snapshot "active_turn"))
                     (>= (length (field snapshot "turns")) turn-count)
                     (zerop (length (field snapshot "queue"))))))))

(defun decision (session)
  (let ((pending nil))
    (wait-for (lambda ()
                (setf pending (find "pending" (array-items (field (agent:session-snapshot session) "decisions"))
                                    :key (lambda (decision) (field decision "status")) :test #'equal))))
    pending))

(defstruct gate (lock (bt2:make-lock)) (ready (bt2:make-condition-variable)) open)
(defun open-gate (gate)
  (bt2:with-lock-held ((gate-lock gate))
    (setf (gate-open gate) t) (bt2:condition-broadcast (gate-ready gate))))
(defun wait-gate (gate)
  (bt2:with-lock-held ((gate-lock gate))
    (loop until (gate-open gate)
          do (unless (bt2:condition-wait (gate-ready gate) (gate-lock gate) :timeout 8)
               (error "Fake operation gate timed out")))))

(defmacro with-manager ((manager directory) &body body)
  `(let* ((,directory (merge-pathnames (format nil "lem-agent-~a/" (store:new-id))
                                     (uiop:temporary-directory)))
          (,manager (agent:make-manager :directory ,directory)))
     (unwind-protect (progn ,@body)
       (agent:close-manager ,manager :wait t)
       (when (uiop:directory-exists-p ,directory)
         (uiop:delete-directory-tree ,directory :validate t)))))

(defun new-session (manager directory &key limits (provider "fake"))
  (let ((session (agent:create-session manager :provider provider :model "fake-model"
                                              :root directory :limits limits)))
    (await (agent:session-ready session)) session))

(defun request-messages (request) (array-items (field request "messages")))
(defun tool-call (name &optional (arguments (agent:json-object)) (id "call-1"))
  (agent:json-object "id" id "name" name "arguments" arguments))
(defun tool-provider (calls)
  (lambda (request emit context)
    (declare (ignore emit context))
    (if (equal "tool" (field (car (last (request-messages request))) "role"))
        (agent:json-object "content" "tools completed")
        (agent:json-object "tool_calls" calls))))

(defun register-review-fixture (manager executor &optional (arguments (agent:json-object "path" "a.txt" "revision" "old-token"
                                                                                    "original" "before" "replacement" "after")))
  (agent:register-provider manager "fake" (tool-provider (vector (tool-call "propose_edit" arguments))))
  (agent:register-tool manager "propose_edit" :schema (agent:json-object) :validate (constantly t)
                       :retain-for-review t :execute executor))

(defun settle (session)
  (wait-for (lambda () (let ((snapshot (agent:session-snapshot session)))
                        (and (member (field snapshot "status") '("idle" "failed") :test #'equal)
                             (zerop (length (field snapshot "queue"))))))))

(deftest durable-submission-identity-survives-trimming-and-restart
  (with-manager (manager directory)
    (let ((requests 0) (identity (store:new-id)))
      (agent:register-provider manager "fake" (lambda (&rest ignored)
                                               (declare (ignore ignored)) (incf requests)
                                               (agent:json-object "content" "done")))
      (let* ((session (new-session manager directory :limits (agent:json-object "turns" 1)))
             (id (agent:session-id session))
             (result (await (agent:submit-message session "exact λ input" :submission-id identity))))
        (idle session)
        (dotimes (index 3) (await (agent:submit-message session (format nil "later ~d" index))) (idle session))
        (ok (= 3 (field (agent:session-snapshot session) "omitted_turns")))
        (ok (equal result (field (agent:find-submission session identity) "result")))
        (let ((before requests))
          (ok (equal result (await (agent:submit-message session "exact λ input" :submission-id identity))))
          (ok (= before requests) "duplicate identity cannot enqueue a second turn after history trimming")
          (ok (signals (await (agent:submit-message session "different" :submission-id identity))))
          (ok (= before requests)))
        (agent:close-manager manager :wait t)
        (setf manager (agent:make-manager :directory directory))
        (multiple-value-bind (sessions errors) (agent:restore-sessions manager)
          (ok (null errors)) (setf session (first sessions)) (await (agent:session-ready session)))
        (ok (equal id (agent:session-id session)))
        (ok (equal result (field (agent:find-submission session identity) "result")))
        (ok (equal result (await (agent:submit-message session "exact λ input" :submission-id identity))))
        (ok (await (agent:acknowledge-submission session identity)))
        (ng (agent:find-submission session identity))
        (ng (await (agent:acknowledge-submission session identity)))
        (ok (zerop (length (field (store:read-private-json directory id :maximum-depth 24) "submissions"))))))))

(deftest submission-capacity-preserves-pending-decisions
  (with-manager (manager directory)
    (agent:register-provider manager "fake" (constantly (agent:json-object "content" "done")))
    (let ((session (new-session manager directory)) (identities nil))
      (dotimes (index 32)
        (let ((id (store:new-id)))
          (push id identities)
          (await (agent:submit-message session (format nil "fill ~d" index) :submission-id id))
          (idle session)))
      (let ((snapshot (agent:session-snapshot session)))
        (ok (signals (await (agent:submit-message session "overflow" :submission-id (store:new-id)))))
        (ok (equalp snapshot (agent:session-snapshot session)) "quota rejection changes neither input nor lifecycle"))
      (agent:register-provider manager "fake"
                               (constantly (agent:json-object "clarification"
                                                              (agent:json-object "question" "Choose" "choices" #("one" "two")))))
      (await (agent:submit-message session "ask"))
      (let* ((pending (decision session)) (id (field pending "id")) (submission-id (store:new-id)))
        (ok (signals (await (agent:resolve-decision session id "one" :submission-id submission-id))))
        (ok (equalp pending (decision session)) "receipt capacity is checked before resolving a decision")
        (await (agent:acknowledge-submission session (first identities)))
        (agent:register-provider manager "fake" (constantly (agent:json-object "content" "done")))
        (ok (await (agent:resolve-decision session id "one" :submission-id submission-id)))
        (idle session)
        (ok (await (agent:resolve-decision session id "one" :submission-id submission-id)))
        (ok (signals (await (agent:resolve-decision session id "two" :submission-id submission-id))))
        (ok (signals (await (agent:submit-message session "one" :submission-id submission-id))))
        (ok (eq t (field (agent:find-submission session submission-id) "result")))
        (ok (agent::validate-restored-record (agent:session-id session)
                                           (store:read-private-json directory (agent:session-id session) :maximum-depth 24)))
        (agent:close-manager manager :wait t)
        (setf manager (agent:make-manager :directory directory))
        (multiple-value-bind (sessions errors) (agent:restore-sessions manager)
          (ok (null errors)) (setf session (first sessions)) (await (agent:session-ready session)))
        (ok (eq t (field (agent:find-submission session submission-id) "result")))
        (ok (eq t (await (agent:resolve-decision session id "one" :submission-id submission-id)))
            "restored clarification receipts preserve the public true result without replay")
        (dolist (invalid (list yason:false nil #()))
          (let* ((record (agent:session-snapshot session))
                 (item (find submission-id (gethash "submissions" record)
                             :key (lambda (item) (gethash "id" item)) :test #'equal)))
            (setf (gethash "result" item) invalid)
            (ok (signals (agent::validate-restored-record (agent:session-id session) record)))))
        (dolist (field '("kind" "digest" "decision_id" "result"))
          (let* ((record (agent:session-snapshot session))
                 (item (find submission-id (gethash "submissions" record)
                             :key (lambda (item) (gethash "id" item)) :test #'equal)))
            (setf (gethash field item) "invalid")
            (ok (signals (agent::validate-restored-record (agent:session-id session) record)))))))))

(deftest submission-write-failure-does-not-publish-acceptance
  (with-manager (manager directory)
    (let* ((session (new-session manager directory)) (id (store:new-id))
           (write (symbol-function 'store:write-private-json)))
      (unwind-protect
           (progn
             (setf (symbol-function 'store:write-private-json)
                   (lambda (directory identifier record &rest options)
                     (when (and (equal identifier (agent:session-id session))
                                (plusp (length (field record "submissions"))))
                       (error "injected journal failure"))
                     (apply write directory identifier record options)))
             (ok (signals (await (agent:submit-message session "retained draft" :submission-id id))))
             (ok (signals (agent:find-submission session id)) "uncertain in-memory publication cannot prove acceptance")
             (ok (signals (await (agent:submit-message session "retained draft" :submission-id id))))
             (ok (zerop (length (field (store:read-private-json directory (agent:session-id session) :maximum-depth 24)
                                      "submissions")))))
        (setf (symbol-function 'store:write-private-json) write)))))

(deftest retained-review-durable-before-effect-and-independent-of-history
  (with-manager (manager directory)
    (let ((durable nil)
          (result (agent:json-object "proposal_id" "historical-proposal"
                                     "needs_activation" yason:false "reviewed" yason:true
                                     "optional" nil "empty" #()
                                     "nested" (vector nil yason:false #()))))
      (register-review-fixture
       manager (lambda (arguments context)
                 (let* ((disk (store:read-private-json directory (agent:operation-session-id context) :maximum-depth 24))
                        (review (first (array-items (field disk "retained_reviews")))))
                   (setf durable (and (equalp arguments (field review "arguments"))
                                      (equal "executing" (field review "status"))
                                      (= 0 (field review "generation")))))
                 result))
      (let ((session (new-session manager directory :limits (agent:json-object "turns" 1))))
        (await (agent:submit-message session "stage")) (idle session)
        (ok durable "the complete candidate is fsynced before the executor runs")
        (let* ((review (first (agent:list-retained-reviews session))) (id (field review "id")))
          (ok (equal "returned" (field review "status"))) (ok (= 1 (field review "generation")))
          (setf (gethash "original" (field review "arguments")) "tampered")
          (ok (equal "before" (field (field (agent:find-retained-review session id) "arguments") "original")))
          (agent:register-provider manager "fake" (constantly (agent:json-object "content" "ordinary turn")))
          (dotimes (index 20)
            (await (agent:submit-message session (format nil "ordinary ~d" index))) (idle session))
          (ok (>= (field (agent:session-snapshot session) "omitted_turns") 20))
          (ok (agent:find-retained-review session id) "turn eviction cannot evict a retained candidate")
          (agent:close-manager manager :wait t)
          (let ((reopened (agent:make-manager :directory directory)))
            (unwind-protect
                 (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                   (ok (null errors))
                   (let ((restored (first sessions)))
                     (await (agent:session-ready restored))
                     (ok (equalp result (field (agent:find-retained-review restored id) "result"))
                         "a completed candidate restores exact JSON values after its originating turn is gone")))
              (agent:close-manager reopened :wait t))))))))

(deftest retained-review-quota-and-explicit-discard
  (with-manager (manager directory)
    (let ((executions 0))
      (ok (signals (agent:register-tool manager "invalid" :schema (agent:json-object) :validate (constantly t)
                                        :execute (constantly nil) :retain-for-review :yes)))
      (register-review-fixture manager (lambda (arguments context)
                                        (declare (ignore arguments context)) (incf executions) "candidate"))
      (let ((session (new-session manager directory :limits (agent:json-object "turns" 1))))
        (dotimes (index 16)
          (await (agent:submit-message session (format nil "stage ~d" index))) (idle session))
        (await (agent:submit-message session "full")) (settle session)
        (ok (equal "failed" (state session)))
        (ok (= 16 executions (length (agent:list-retained-reviews session)))
            "full retention fails before the next executor, preserving every older candidate")
        (let* ((review (first (agent:list-retained-reviews session))) (id (field review "id")))
          (ok (signals (await (agent:discard-retained-review session id :expected-generation 0))))
          (ok (await (agent:discard-retained-review session id :expected-generation 1)))
          (ok (null (await (agent:discard-retained-review session id :expected-generation 1))))
          (ok (null (agent:find-retained-review session id)))
          (await (agent:submit-message session "capacity released")) (idle session)
          (ok (= 17 executions))
          (ok (not (find id (agent:list-retained-reviews session) :key (lambda (entry) (field entry "id")) :test #'equal))))))))

(deftest retained-review-byte-reservation-and-result-shape
  (with-manager (manager directory)
    (let ((executions 0))
      (register-review-fixture manager (lambda (arguments context)
                                        (declare (ignore arguments context)) (incf executions)
                                        (make-string 30000 :initial-element #\x))
                               (agent:json-object "large" (make-string 12000 :initial-element #\a)))
      (let ((session (new-session manager directory :limits (agent:json-object "turns" 1))))
        (loop repeat 16 do (await (agent:submit-message session "large candidate")) (settle session)
              when (equal "failed" (state session)) return nil)
        (ok (< 1 executions 16) "aggregate quota reserves the result before the count quota is reached")
        (ok (= executions (length (agent:list-retained-reviews session))))
        (ok (<= (agent::encoded-size (field (agent:session-snapshot session) "retained_reviews")) (* 512 1024))))))
  (with-manager (manager directory)
    (register-review-fixture manager (lambda (arguments context)
                                      (declare (ignore arguments context)) (make-array 2000 :initial-element 0)))
    (let ((session (new-session manager directory)))
      (await (agent:submit-message session "large shape")) (idle session)
      (let ((review (first (agent:list-retained-reviews session))))
        (ok (equal "unknown" (field review "status")))
        (ok (search "omitted" (field (field review "result") "error")))
        (ok (equal "after" (field (field review "arguments") "replacement"))
            "an excessive result shape cannot discard the original candidate")))))

(deftest retained-review-combined-json-budget-prevents-execution
  (with-manager (manager directory)
    (let ((executions 0) (bulk 0))
      (agent:register-provider manager "fake"
                               (tool-provider (vector (tool-call "bulk" (agent:json-object) "bulk-1")
                                                      (tool-call "bulk" (agent:json-object) "bulk-2")
                                                      (tool-call "retained" (agent:json-object) "candidate"))))
      (agent:register-tool manager "bulk" :schema (agent:json-object) :validate (constantly t)
                           :execute (lambda (arguments context)
                                      (declare (ignore arguments context)) (incf bulk)
                                      (map 'vector (lambda (ignored) (declare (ignore ignored))
                                                     (make-array 970 :initial-element 0)) (make-array 10))))
      (agent:register-tool manager "retained" :schema (agent:json-object) :validate (constantly t)
                           :retain-for-review t :execute (lambda (arguments context)
                                                         (declare (ignore arguments context)) (incf executions)))
      (let ((session (new-session manager directory)))
        (await (agent:submit-message session "reserve combined graph"))
        (wait-for (lambda () (equal "failed" (state session))))
        (ok (and (= 2 bulk) (zerop executions))
            "JSON node reservation prevents execution before result copies could exceed the journal budget")
        (let ((disk (store:read-private-json directory (agent:session-id session) :maximum-depth 24)))
          (ok (<= (agent::json-shape (agent:json-copy disk)) 20000))
          (ok (agent::validate-restored-record (agent:session-id session) disk)))))))

(deftest retained-review-reserves-current-turn-budget
  (dolist (result-limit '(32768 256))
    (with-manager (manager directory)
      (let ((executions 0))
        (register-review-fixture manager (lambda (arguments context)
                                          (declare (ignore arguments context)) (incf executions) "candidate"))
        (let ((session (new-session manager directory :limits (agent:json-object "history" 4096 "result" result-limit))))
          (await (agent:submit-message session "bounded turn")) (settle session)
          (ok (= executions (if (= result-limit 256) 1 0))
              "the current turn reserves the permitted result size before its executor")
          (ok (equal (state session) (if (= result-limit 256) "idle" "failed"))))))))

(deftest retained-review-failed-result-append-remains-recoverable
  (with-manager (manager directory)
    (let ((original (symbol-function 'agent::append-message)))
      (register-review-fixture manager (lambda (arguments context) (declare (ignore arguments context)) "candidate"))
      (let ((session (new-session manager directory)))
        (unwind-protect
             (progn
               (setf (symbol-function 'agent::append-message)
                     (lambda (target message)
                       (when (and (eq target session) (equal "tool" (field message "role")))
                         (error "Injected result append failure"))
                       (funcall original target message)))
               (await (agent:submit-message session "result failure"))
               (wait-for (lambda () (equal "failed" (state session))))
               (ok (equal "unknown" (field (first (agent:list-retained-reviews session)) "status")))
               (ok (agent::validate-restored-record
                    (agent:session-id session) (store:read-private-json directory (agent:session-id session) :maximum-depth 24))
                   "failed transcript insertion cannot leave a conflicting returned archive record"))
          (setf (symbol-function 'agent::append-message) original))))))

(deftest retained-review-write-failure-never-launches
  (dolist (after-rename '(nil t))
    (with-manager (manager directory)
      (let ((executions 0) (injected nil) (original (symbol-function 'store:write-private-json)))
        (register-review-fixture manager (lambda (arguments context)
                                          (declare (ignore arguments context)) (incf executions)))
        (let ((session (new-session manager directory)))
          (unwind-protect
               (progn
                 (setf (symbol-function 'store:write-private-json)
                       (lambda (path id record &rest options)
                         (if (and (equal id (agent:session-id session))
                                  (plusp (length (field record "retained_reviews"))))
                             (progn (setf injected t)
                                    (when after-rename (apply original path id record options))
                                    (error "Injected review checkpoint failure"))
                             (apply original path id record options))))
                 (await (agent:submit-message session "no durable retention"))
                 (wait-for (lambda () (equal "failed" (state session))))
                 (ok (and injected (zerop executions)) "failed or uncertain retention never launches the executor"))
            (setf (symbol-function 'store:write-private-json) original))
          (agent:close-manager manager :wait t)
          (let ((reopened (agent:make-manager :directory directory)))
            (unwind-protect
                 (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                   (ok (null errors))
                   (let ((restored (first sessions)))
                     (await (agent:session-ready restored))
                     (ok (every (lambda (review) (equal "unknown" (field review "status")))
                                (agent:list-retained-reviews restored)))
                     (ok (zerop executions))))
              (agent:close-manager reopened :wait t))))))))

(deftest retained-review-shutdown-discards-late-results
  (with-manager (manager directory)
    (let ((gate (make-gate)) (entered nil) (cancelled nil) (reopened nil))
      (register-review-fixture manager (lambda (arguments context)
                                        (declare (ignore arguments))
                                        (agent:register-cancellation context (lambda () (setf cancelled t)))
                                        (setf entered t) (wait-gate gate)
                                        (agent:json-object "proposal_id" "late")))
      (let ((session (new-session manager directory)))
        (unwind-protect
             (progn
               (await (agent:submit-message session "uncooperative")) (wait-for (lambda () entered))
               (let* ((review (first (agent:list-retained-reviews session))) (id (field review "id")))
                 (ok (signals (await (agent:discard-retained-review session id :expected-generation 0))))
                 (agent:close-manager manager :wait t) (wait-for (lambda () cancelled))
                 (setf reopened (agent:make-manager :directory directory))
                 (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                   (ok (null errors))
                   (let ((restored (first sessions)))
                     (await (agent:session-ready restored))
                     (let ((before (agent:find-retained-review restored id)))
                       (ok (and (equal "unknown" (field before "status")) (= 1 (field before "generation"))))
                       (open-gate gate)
                       (dolist (entry (agent::session-workers session)) (bt2:join-thread (car entry)))
                       (ok (equalp before (agent:find-retained-review restored id))
                           "an old worker cannot update the new owner's archive")
                       (ok (await (agent:discard-retained-review restored id :expected-generation 1))))))))
          (open-gate gate)
          (when reopened (agent:close-manager reopened :wait t)))))))

(deftest retained-review-result-space-survives-queued-escaping
  (with-manager (manager directory)
    (let ((gate (make-gate)) (entered nil))
      (register-review-fixture manager (lambda (arguments context)
                                        (declare (ignore arguments context)) (setf entered t) (wait-gate gate)
                                        (make-string 5000 :initial-element #\Null)))
      (let ((session (new-session manager directory :limits (agent:json-object "turns" 1))))
        (unwind-protect
             (progn
               (await (agent:submit-message session "large queued input")) (wait-for (lambda () entered))
               (let ((accepted 0) (rejected 0))
                 (dotimes (index 8)
                   (declare (ignore index))
                   (handler-case (progn (await (agent:submit-message session (make-string 65536 :initial-element #\Null)))
                                        (incf accepted))
                     (agent::request-rejected () (incf rejected))))
                 (ok (and (plusp accepted) (plusp rejected)))
                 (ok (equal "running" (state session))
                     "encoded-byte admission rejects excessive follow-ups without interrupting the retained tool")
                 (ok (not (agent::session-poisoned session)))
                 ;; Follow-ups should be ordinary completed messages, not another retained tool.
                 (agent:register-provider manager "fake" (constantly (agent:json-object "content" "done")))
                 (open-gate gate) (idle session)
                 (let ((review (first (agent:list-retained-reviews session))))
                   (ok (equal "returned" (field review "status")))
                   (ok (= 5000 (length (field review "result"))))
                   (ok (agent::validate-restored-record
                        (agent:session-id session)
                        (store:read-private-json directory (agent:session-id session) :maximum-depth 24))))))
          (open-gate gate))))))

(deftest retained-review-failed-discard-and-closed-record-cleanup
  (with-manager (manager directory)
    (register-review-fixture manager (lambda (arguments context) (declare (ignore arguments context)) "candidate"))
    (let ((session (new-session manager directory)) (original (symbol-function 'store:write-private-json)))
      (await (agent:submit-message session "candidate")) (idle session)
      (let* ((review (first (agent:list-retained-reviews session))) (id (field review "id")))
        (unwind-protect
             (progn
               (setf (symbol-function 'store:write-private-json)
                     (lambda (path key record &rest options)
                       (if (equal key (agent:session-id session)) (error "Injected discard write failure")
                           (apply original path key record options))))
               (ok (signals (await (agent:discard-retained-review session id :expected-generation 1))))
               (wait-for (lambda () (agent::session-poisoned session)))
               (ok (agent:find-retained-review session id) "a failed discard keeps the historical live copy"))
          (setf (symbol-function 'store:write-private-json) original))
        (await (agent:close-session session))
        (ok (signals (await (agent:discard-retained-review session id :expected-generation 1))))
        (agent:close-manager manager :wait t)
        (let ((reopened (agent:make-manager :directory directory)))
          (unwind-protect
               (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                 (ok (null errors))
                 (let ((restored (first sessions)))
                   (await (agent:session-ready restored))
                   (ok (equal "closed" (state restored)))
                   (ok (await (agent:discard-retained-review restored id :expected-generation 1)))
                   (ok (equal "closed" (state restored)) "archive cleanup cannot reopen a permanently closed session")))
            (agent:close-manager reopened :wait t)))))))

(deftest invalid-retained-reviews-and-empty-schema-default
  (with-manager (manager directory)
    (register-review-fixture manager (lambda (arguments context) (declare (ignore arguments context)) "candidate"))
    (let ((session (new-session manager directory)))
      (await (agent:submit-message session "candidate")) (idle session)
      (let ((baseline (store:read-private-json directory (agent:session-id session) :maximum-depth 24)))
        (dolist (mutate
                  (list (lambda (record) (setf (gethash "retained_reviews" record) "invalid"))
                        (lambda (record) (setf (gethash "retained_reviews" record)
                                              (concatenate 'vector (field record "retained_reviews") (field record "retained_reviews"))))

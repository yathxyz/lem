        (open-gate gate)
        (setf (symbol-function 'store:write-private-json) original)
        (when reopened (agent:close-manager reopened :wait t))))))

(deftest invalid-journals-are-never-rewritten
  (with-manager (manager directory)
    (agent:register-provider manager "fake" (tool-provider (vector (tool-call "effect"))))
    (agent:register-tool manager "effect" :schema (agent:json-object) :validate (constantly t)
                         :permission t :execute (lambda (arguments context) (declare (ignore arguments context)) "effect"))
    (let ((session (new-session manager directory)))
      (await (agent:submit-message session "effect")) (decision session)
      (let ((baseline (store:read-private-json directory (agent:session-id session) :maximum-depth 24)))
        (dolist (mutate
                  (list
                   (lambda (record) (setf (gethash "active_turn" record) (store:new-id)))
                   (lambda (record) (setf (gethash "status" record) "idle"))
                   (lambda (record) (setf (gethash "turn_id" (aref (field record "decisions") 0)) (store:new-id)))
                   (lambda (record) (setf (gethash "status" (aref (field record "decisions") 0)) "resolved"
                                         (gethash "answer" (aref (field record "decisions") 0)) "maybe"))
                   (lambda (record) (setf (gethash "choices" (aref (field record "decisions") 0)) #("allow")))
                   (lambda (record) (setf (gethash "arguments" (aref (field record "decisions") 0))
                                         (agent:json-object "forged" t)))
                   (lambda (record) (setf (gethash "call_id" (aref (field record "decisions") 0)) "missing"))
                   (lambda (record) (setf (gethash "turns" record) (vector (aref (field record "turns") 0)
                                                                         (agent:json-copy (aref (field record "turns") 0)))))
                   (lambda (record)
                     (let* ((turn (aref (field record "turns") 0)) (messages (field turn "messages")))
                       (setf (gethash "messages" turn)
                             (concatenate 'vector messages
                                          (vector (agent:json-object "role" "tool" "tool_call_id" "missing"
                                                                    "name" "effect" "content" "forged"))))))))
          (with-manager (restored directory-copy)
            (let* ((record (agent:json-copy baseline)) (id (agent:session-id session)))
              (funcall mutate record)
              (let* ((path (store:write-private-json directory-copy id record :maximum-depth 24))
                     (before (uiop:read-file-string path)))
                (multiple-value-bind (sessions errors) (agent:restore-sessions restored)
                  (ok (and (null sessions) (= 1 (length errors))) "inconsistent durable state is rejected")
                  (ok (equal before (uiop:read-file-string path)) "rejected journal bytes remain intact"))))))))))

(deftest killed-runtime-releases-lease-and-never-replays
  (dolist (phase '("permission" "tool"))
    (let* ((directory (merge-pathnames (format nil "lem-agent-crash-~a/" (store:new-id)) (uiop:temporary-directory)))
           (ready (merge-pathnames "ready.txt" directory))
           (effect (merge-pathnames "effect.txt" directory))
           (log (merge-pathnames "worker.log" directory))
           (process nil))
      (unwind-protect
           (progn
             (store:ensure-private-directory directory)
             (setf process
                   (sb-ext:run-program
                    (namestring sb-ext:*runtime-pathname*)
                    (list "--noinform" "--no-sysinit" "--no-userinit" "--script"
                          (namestring (asdf:system-relative-pathname "lem-agent" "tests/crash-worker.lisp"))
                          (namestring (asdf:system-source-directory "lem")) (namestring directory) phase)
                    :search nil :wait nil :input nil :output log :error :output))
             (loop repeat 1500 until (probe-file ready)
                   do (unless (sb-ext:process-alive-p process)
                        (error "Crash fixture exited early: ~a" (uiop:read-file-string log)))
                      (sleep 0.01)
                   finally (unless (probe-file ready) (error "Crash fixture did not reach its durable boundary")))
             (ok (signals (agent:make-manager :directory directory)) "a live separate Lisp process owns the journal lease")
             (sb-ext:process-kill process sb-posix:sigkill)
             (sb-ext:process-wait process)
             (let ((manager (agent:make-manager :directory directory)) (requests 0) (executions 0))
               (unwind-protect
                    (progn
                      (agent:register-provider manager "fake"
                                               (lambda (request emit context)
                                                 (declare (ignore request emit context))
                                                 (incf requests) (agent:json-object "content" "fresh continuation")))
                      (agent:register-tool manager "effect" :schema (agent:json-object) :validate (constantly t)
                                           :permission t :execute (lambda (arguments context)
                                                                    (declare (ignore arguments context)) (incf executions)))
                      (multiple-value-bind (sessions errors) (agent:restore-sessions manager)
                        (ok (null errors))
                        (let ((session (first sessions)))
                          (await (agent:session-ready session))
                          (ok (equal "interrupted" (state session)) "SIGKILL recovers the active turn as interrupted")
                          (ok (and (zerop requests) (zerop executions)) "recovery invokes neither provider nor uncertain tool")
                          (let* ((snapshot (agent:session-snapshot session))
                                 (decision (aref (field snapshot "decisions") 0))
                                 (messages (field (aref (field snapshot "turns") 0) "messages"))
                                 (result (aref messages (1- (length messages)))))
                            (ok (equal (field decision "status") (if (equal phase "permission") "cancelled" "resolved")))
                            (ok (equal (field (field result "content") "outcome")
                                       (if (equal phase "permission") "not-started" "unknown"))
                                "recovery distinguishes unapproved work from a durably started uncertain effect")
                            (ok (null (await (agent:resolve-decision session (field decision "id") "allow")))))
                          (await (agent:submit-message session "continue deliberately")) (idle session 2)
                          (ok (and (= requests 1) (zerop executions)) "deliberate continuation starts a fresh provider request")
                          (ok (if (equal phase "tool") (equal (uiop:read-file-lines effect) '("effect"))
                                  (not (probe-file effect)))
                              "the interrupted external effect is not replayed"))))
                 (agent:close-manager manager :wait t))))
        (when process
          (when (sb-ext:process-alive-p process) (sb-ext:process-kill process sb-posix:sigkill))
          (sb-ext:process-wait process) (sb-ext:process-close process))
        (when (uiop:directory-exists-p directory) (uiop:delete-directory-tree directory :validate t))))))


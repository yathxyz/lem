(deftest manager-lease-survives-asynchronous-close
  (with-manager (manager directory)
    (let ((publishing nil) (gate (make-gate)) (original (symbol-function 'store:write-private-json)))
      (agent:register-provider manager "fake" (constantly (agent:json-object "content" "ready")))
      (let ((session (new-session manager directory)))
        (ok (signals (agent:make-manager :directory directory)) "a second manager cannot acquire this journal namespace")
        (ok (= 1 (logand 1 (sb-posix:fcntl (agent::manager-lease manager) sb-posix:f-getfd)))
            "the manager lease does not leak through subprocess exec")
        (unwind-protect
             (progn
               (setf (symbol-function 'store:write-private-json)
                     (lambda (path id record &rest options)
                       (when (and (not publishing) (equal id (agent:session-id session)))
                         (setf publishing t) (wait-gate gate))
                       (apply original path id record options)))
               (agent:close-manager manager)
               (wait-for (lambda () publishing))
               (ok (signals (agent:make-manager :directory directory))
                   "asynchronous close keeps ownership until the final actor write ends")
               (ok (signals (agent:create-session manager :provider "fake" :model "fake" :root directory)))
               (open-gate gate)
               (agent:close-manager manager :wait t))
          (open-gate gate) (setf (symbol-function 'store:write-private-json) original))
        (let ((reopened (agent:make-manager :directory directory)))
          (unwind-protect
               (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                 (ok (null errors))
                 (let ((restored (first sessions)))
                   (await (agent:session-ready restored))
                   (ok (equal "idle" (state restored)) "host shutdown preserves an idle session")
                   (await (agent:resume-session restored))
                   (ok (equal "idle" (state restored)) "a restored session remains usable")))
            (agent:close-manager reopened :wait t)))))))

(deftest graceful-shutdown-preserves-session-lifecycle
  (dolist (phase '(:idle :queued :permission :running-tool :closed))
    (with-manager (manager directory)
      (let ((gate (make-gate)) (entered nil) (cancelled nil) (executions 0)
            (context nil) (reopened nil))
        (agent:register-provider manager "fake" (tool-provider (vector (tool-call "effect"))))
        (agent:register-tool
         manager "effect" :schema (agent:json-object) :validate (constantly t) :permission t
         :execute (lambda (arguments operation)
                    (declare (ignore arguments))
                    (setf context operation)
                    (agent:register-cancellation operation (lambda () (setf cancelled t)))
                    (incf executions) (setf entered t)
                    ;; Deliberately ignore cancellation until the fixture releases us.
                    (wait-gate gate) (agent:json-object "late" t)))
        (let ((session (new-session manager directory)))
          (unwind-protect
               (progn
                 (when (member phase '(:queued :permission :running-tool))
                   (await (agent:submit-message session "effect"))
                   (let ((pending (decision session)))
                     (await (agent:submit-message session "retained follow-up"))
                     (case phase
                       (:queued (await (agent:interrupt-session session)))
                       (:running-tool
                        (await (agent:resolve-decision session (field pending "id") "allow"))
                        (wait-for (lambda () entered))))))
                 (when (eq phase :closed) (await (agent:close-session session)))
                 (agent:close-manager manager :wait t)
                 (ok (not (bt2:thread-alive-p (agent::session-thread session)))
                     "host shutdown stops every journal actor")
                 (when context
                   (wait-for (lambda () cancelled))
                   (ok (not (agent:operation-live-p context)))
                   (ok (some (lambda (entry) (bt2:thread-alive-p (car entry)))
                             (agent::session-workers session))
                       "an uncooperative tool cannot hold the manager lease"))
                 (ok (signals (await (agent:submit-message session "obsolete handle"))))
                 (unless (eq phase :closed)
                   (ok (signals (await (agent:close-session session)))
                       "permanent closure cannot be enqueued after host suspension"))
                 (setf reopened (agent:make-manager :directory directory))
                 (let ((requests 0))
                   (agent:register-provider reopened "fake"
                                            (lambda (request emit operation)
                                              (declare (ignore request emit operation))
                                              (incf requests) (agent:json-object "content" "fresh")))
                   (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                     (ok (null errors))
                     (let* ((restored (first sessions))
                            (ready (await (agent:session-ready restored)))
                            (snapshot (agent:session-snapshot restored)))
                       (declare (ignore ready))
                       (ok (equal (field snapshot "status")
                                  (case phase (:idle "idle") (:closed "closed") (t "interrupted"))))
                       (ok (zerop requests) "restoration never invokes a provider or replays work")
                       (when (member phase '(:queued :permission :running-tool))
                         (let* ((pending (aref (field snapshot "decisions") 0))
                                (messages (field (aref (field snapshot "turns") 0) "messages"))
                                (result (field (aref messages (1- (length messages))) "content")))
                           (ok (equal "retained follow-up" (field (aref (field snapshot "queue") 0) "text")))
                           (ok (equal (field result "outcome")
                                      (if (eq phase :running-tool) "unknown" "not-started")))
                           (ok (equal (field pending "status")
                                      (if (eq phase :running-tool) "resolved" "cancelled")))
                           (when (eq phase :permission)
                             (ok (equal "host-shutdown" (field pending "reason"))))
                           (ok (null (await (agent:resolve-decision restored (field pending "id") "allow"))))))
                       ;; Return the old worker while the new actor owns the same
                       ;; journal. Neither late results nor diagnostics may write.
                       (let* ((path (merge-pathnames (format nil "~a.json" (agent:session-id session)) directory))
                              (before (uiop:read-file-string path)))
                         (open-gate gate)
                         (dolist (entry (agent::session-workers session)) (bt2:join-thread (car entry)))
                         (ok (equal before (uiop:read-file-string path))
                             "old workers cannot alter journals owned by the restored manager"))
                       (if (eq phase :closed)
                           (progn
                             (await (agent:interrupt-session restored))
                             (ok (equal "closed" (state restored)))
                             (ok (signals (await (agent:resume-session restored))))
                             (ok (signals (await (agent:submit-message restored "reopen")))))
                           (progn
                             (await (agent:resume-session restored))
                             (if (eq phase :idle)
                                 (progn (await (agent:submit-message restored "new turn")) (idle restored))
                                 (idle restored 2))
                             (ok (= 1 requests) "explicit continuation runs exactly one fresh turn")
                             (ok (= executions (if (eq phase :running-tool) 1 0)))))))))
            (open-gate gate)
            (when reopened (agent:close-manager reopened :wait t))))))))

(deftest shutdown-retains-accepted-mailbox-messages
  (with-manager (manager directory)
    (let ((gate (make-gate)) (publishing nil) (requests 0) (reopened nil))
      (agent:register-provider manager "fake"
                               (lambda (request emit context)
                                 (declare (ignore request emit context))
                                 (incf requests) (agent:json-object "content" "fresh")))
      (let ((session (new-session manager directory)))
        (agent:subscribe-session
         session (lambda (event)
                   (when (and (not publishing) (equal "message_queued" (field event "type")))
                     (setf publishing t) (wait-gate gate))))
        (unwind-protect
             (let ((first (agent:submit-message session "first queued")))
               (wait-for (lambda () publishing))
               ;; INTERRUPT synchronizes the persisted generation before SUBMIT
               ;; is drained. The closed-host guard must still prevent a turn.
               (let* ((interrupt (agent:interrupt-session session))
                      (second (agent:submit-message session "second queued"))
                      (receipts (agent:close-manager manager)))
                 (ok (signals (agent:make-manager :directory directory)))
                 (open-gate gate)
                 (mapc #'await (append (list first interrupt second) receipts))
                 (agent:close-manager manager :wait t))
               (ok (zerop requests))
               (let ((snapshot (agent:session-snapshot session)))
                 (ok (zerop (length (field snapshot "turns"))) "shutdown does not consume accepted follow-ups")
                 (ok (= 2 (length (field snapshot "queue")))))
               (setf reopened (agent:make-manager :directory directory))
               (multiple-value-bind (sessions errors) (agent:restore-sessions reopened)
                 (ok (null errors))
                 (let ((restored (first sessions)))
                   (await (agent:session-ready restored))
                   (ok (equal '("first queued" "second queued")
                              (map 'list (lambda (message) (field message "text"))
                                   (field (agent:session-snapshot restored) "queue"))))
                   (ok (zerop requests)))))
          (open-gate gate)
          (when reopened (agent:close-manager reopened :wait t)))))))


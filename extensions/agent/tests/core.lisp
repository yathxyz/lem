      (await (agent:submit-message session "retained follow-up"))
      (unwind-protect
           (progn
             (setf (symbol-function 'store:write-private-json)
                   (lambda (path id record &rest options)
                     (if (equal id (agent:session-id session))
                         (progn (setf writing t) (wait-gate gate) (error "Injected final checkpoint failure"))
                         (apply original path id record options))))
             (let ((receipts (agent:close-manager manager)))
               (wait-for (lambda () writing))
               (ok (signals (agent:make-manager :directory directory)))
               (open-gate gate)
               (ok (signals (await (first receipts))) "the shutdown receipt reports failed durability")
               (agent:close-manager manager :wait t))
             (ok (not (bt2:thread-alive-p (agent::session-thread session)))
                 "a failed final checkpoint still stops the actor before releasing ownership")
             (setf (symbol-function 'store:write-private-json) original

(deftest approval-is-durable-and-resolves-once
  (with-manager (manager directory)
    (let ((executions 0) (durable-before-action nil) (results '()) (lock (bt2:make-lock)))
      (agent:register-provider manager "fake" (tool-provider (vector (tool-call "change" (agent:json-object "n" 3)))))
      (agent:register-tool
       manager "change" :schema (agent:json-object "type" "object")
       :validate (lambda (arguments) (= 3 (field arguments "n"))) :permission t
       :execute
       (lambda (arguments context)
         (declare (ignore arguments))
         (let* ((record (store:read-private-json directory (agent:operation-session-id context) :maximum-depth 24))
                (decision (first (array-items (field record "decisions"))))
                (turn (first (array-items (field record "turns")))))
           (setf durable-before-action (and (equal "resolved" (field decision "status"))
                                           (equal "allow" (field decision "answer"))
                                           (equal '("call-1") (array-items (field turn "started_tools"))))))
         (incf executions) (agent:json-object "changed" t)))
      (let* ((session (new-session manager directory)) (request (agent:submit-message session "change it")))
        (await request)
        (let* ((pending (decision session)) (id (field pending "id"))
               (disk (store:read-private-json directory (agent:session-id session) :maximum-depth 24)))
          (ok (equal id (field (first (array-items (field disk "decisions"))) "id"))
              "pending permission has a durable stable identifier")
          (ok (zerop executions) "a pending decision is not approval")
          (let ((threads
                  (loop repeat 12 collect
                        (bt2:make-thread
                         (lambda ()
                           (let ((result (await (agent:resolve-decision session id "allow"))))
                             (bt2:with-lock-held (lock) (push result results))))))))
            (dolist (thread threads) (bt2:join-thread thread)))
          (idle session)
          (ok (= 1 (count t results)) "concurrent resolutions have exactly one winner")
          (ok (= 1 executions) "one approval dispatches the tool once")
          (ok durable-before-action "resolution and execution intent reach disk before the tool runs")
          (ok (null (await (agent:resolve-decision session id "deny")))))))))


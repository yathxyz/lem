(deftest restart-preserves-decisions-without-replaying-tools
  (dolist (phase '(:permission :running-tool))
    (with-manager (manager directory)
      (let ((gate (make-gate)) (executions 0) (entered nil))
        (agent:register-provider manager "fake" (tool-provider (vector (tool-call "effect"))))
        (agent:register-tool
         manager "effect" :schema (agent:json-object) :validate (constantly t) :permission t
         :execute (lambda (arguments context)
                    (declare (ignore arguments))
                    (agent:register-cancellation context (lambda () (open-gate gate)))
                    (incf executions) (setf entered t) (wait-gate gate) "completed"))
        (let ((session (new-session manager directory)))
          (unwind-protect
               (progn
                 (await (agent:submit-message session "effect"))
                 (let ((id (field (decision session) "id")))
                   (await (agent:submit-message session "deliberate follow-up"))
                   (when (eq phase :running-tool)
                     (await (agent:resolve-decision session id "allow"))
                     (wait-for (lambda () entered)))
                   ;; Copy the actual durable crash boundary into a fresh manager
                   ;; namespace; the old process stack is deliberately unavailable.
                   (let ((record (store:read-private-json directory (agent:session-id session) :maximum-depth 24)))
                     (with-manager (restored-manager restored-directory)
                       (let ((requests 0))
                         (agent:register-provider
                          restored-manager "fake"
                          (lambda (request emit context)
                            (declare (ignore emit context))
                            (incf requests)
                            (let ((calls 0) (results 0))
                              (dolist (message (request-messages request))
                                (incf calls (length (field message "tool_calls")))
                                (when (equal "tool" (field message "role")) (incf results)))
                              (unless (= calls results) (error "Unpaired call in restored context")))
                            (agent:json-object "content" "fresh work")))
                         (store:write-private-json restored-directory (agent:session-id session) record :maximum-depth 24)
                         (multiple-value-bind (sessions failures) (agent:restore-sessions restored-manager)
                           (ok (null failures))
                           (let* ((restored (first sessions))
                                  (ready (await (agent:session-ready restored)))
                                  (snapshot (agent:session-snapshot restored))
                                  (decision (aref (field snapshot "decisions") 0)))
                             (declare (ignore ready))
                             (ok (equal "interrupted" (field snapshot "status")))
                             (ok (equal id (field decision "id")) "decision identity survives restart")
                             (if (eq phase :permission)
                                 (ok (and (equal "cancelled" (field decision "status"))
                                          (equal "daemon-interrupted" (field decision "reason"))))
                                 (ok (equal "resolved" (field decision "status"))))
                             (ok (null (await (agent:resolve-decision restored id "allow"))))
                             (ok (zerop requests) "recovery never starts queued work or replays an uncertain action")
                             (await (agent:resume-session restored)) (idle restored 2)
                             (ok (= 1 requests) "explicit resume runs only the retained follow-up")
                             (ok (= executions (if (eq phase :permission) 0 1)))
                             (ok (equal "interrupted" (field (aref (field (agent:session-snapshot restored) "turns") 0)
                                                               "status"))))))))))
            (open-gate gate)))))))

